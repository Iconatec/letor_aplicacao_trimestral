def extrair_blocos_total_bradesco(texto: str):
    linhas = [linha.strip() for linha in texto.splitlines() if linha.strip()]
    blocos = []
    operacoes = []
    i = 0

    padrao_data = re.compile(r"^\d{2}/\d{2}/\d{4}$")
    padrao_numero = re.compile(r"^\d{1,3}(?:\.\d{3})*,\d{2,4}$")

    while i < len(linhas):
        linha = linhas[i]

        if padrao_data.fullmatch(linha):
            operacao = {
                "dt_aplicacao": linha,
                "dt_vencto": "",
                "dt_resgate": "",
            }

            if i + 1 < len(linhas) and padrao_data.fullmatch(linhas[i + 1]):
                operacao["dt_vencto"] = linhas[i + 1]

            if i + 2 < len(linhas) and padrao_data.fullmatch(linhas[i + 2]):
                operacao["dt_resgate"] = linhas[i + 2]

            operacoes.append(operacao)
            i += 1
            continue

        if linha.lower() == "total":
            numeros = []
            j = i + 1

            while j < len(linhas):
                encontrados = re.findall(
                    r"\d{1,3}(?:\.\d{3})*,\d{2,4}",
                    linhas[j],
                )

                if not encontrados:
                    break

                numeros.extend(encontrados)
                j += 1

            # O valor 0,0000 é a taxa e não pertence às colunas financeiras.
            numeros = [numero for numero in numeros if numero != "0,0000"]

            if len(numeros) >= 7:
                blocos.append({
                    "valores": numeros[:7],
                    "operacoes": operacoes.copy(),
                })

            operacoes = []
            i = j
            continue

        i += 1

    return {
        "linhas": linhas,
        "blocos": blocos,
    }



def extrair_nome_cliente_bradesco(texto: str) -> str:
    match = re.search(r"Agência/conta:\s*\n\s*([^\n|]+)", texto, re.I)
    return match.group(1).strip() if match else ""


def extrair_mes_bradesco(texto: str) -> str:
    match = re.search(r"(\d{2}/\d{2}/\d{4})\s*\n\s*(?:até)", texto, re.I)
    if match:
        return match.group(1)[3:]
    match = re.search(r"Período\s+de:\s*\n?\s*(\d{2}/\d{2}/\d{4})", texto, re.I)
    return match.group(1)[3:] if match else ""


def numero_br(valor):
    return texto_para_numero(valor)


def processar_extrato_bradesco(caminho_pdf: Path, nome_banco: str) -> dict:
    texto_original = extrair_texto_pdf(caminho_pdf)
    dados = extrair_blocos_total_bradesco(texto_original)
    blocos = dados["blocos"]

    resultado = {coluna: "" for coluna in COLUNAS}
    resultado.update({
        "Arquivo": caminho_pdf.stem,
        "Cliente": extrair_nome_cliente_bradesco(texto_original),
        "Conta": extrair_conta_bradesco(texto_original),
        "Mês": extrair_mes_bradesco(texto_original),
        "Saldo Anterior": 0.0,
        "Aplicações": 0.0,
        "Resgates": 0.0,
        "Rendimento bruto mês": 0.0,
        "IRRF": 0.0,
        "IOF": 0.0,
        "Saldo Bruto": 0.0,
        "Banco": "Bradesco",
    })

    if len(blocos) < 4:
        return resultado

    def valor(bloco, indice):
        valores = bloco.get("valores", [])
        return numero_br(valores[indice]) if len(valores) > indice else 0.0

    bloco_saldo_anterior = blocos[0]
    bloco_aplicacoes = blocos[1]
    bloco_resgates = blocos[2]
    bloco_saldo_final = blocos[-1]

    # Índices após remover o 0,0000:
    # 0 = Vlr. Princ.
    # 1 = Vlr. Bruto
    # 2 = Renda Total
    # 3 = Vlr. IOF
    # 4 = Vlr. IRRF
    # 5 = Vlr. Líquido
    # 6 = Renda Bruta Per

    resultado["Saldo Anterior"] = valor(bloco_saldo_anterior, 1)
    resultado["Aplicações"] = valor(bloco_aplicacoes, 0)
    resultado["Resgates"] = valor(bloco_resgates, 5)
    resultado["IRRF"] = valor(bloco_resgates, 4)
    resultado["IOF"] = valor(bloco_resgates, 3)
    resultado["Rendimento bruto mês"] = (
        valor(bloco_resgates, 6)
        + valor(bloco_saldo_final, 6)
    )
    resultado["Saldo Bruto"] = valor(bloco_saldo_final, 1)

    return resultado




def processar_extrato_sicredi_poupanca(caminho_pdf: Path, nome_banco: str) -> dict:
    texto_original = extrair_texto_pdf(caminho_pdf)
    texto = re.sub(r"\s+", " ", texto_original).strip()
    saldo = re.search(r"SALDO ANTERIOR\s+([\d.]+,\d{2})", texto, re.I)
    atual = re.search(r"SALDO ATUAL\s+([\d.]+,\d{2})", texto, re.I) or re.search(r"Saldo Bruto\s+([\d.]+,\d{2})", texto, re.I)
    irrf = re.search(r"ENCARGOS DE IRRF\s+([\d.]+,\d{2})", texto, re.I) or re.search(r"IRRF\s+([\d.]+,\d{2})", texto, re.I)
    return {
        "Arquivo": caminho_pdf.stem,
        "Cliente": extrair_cliente_sicredi(texto_original),
        "Conta": extrair_conta_sicredi_poupanca(texto_original),
        "Mês": extrair_mes_sicredi(texto_original),
        "Saldo Anterior": texto_para_numero(saldo.group(1)) if saldo else 0.0,
        "Aplicações": sum(texto_para_numero(m.group(1)) for m in re.finditer(r"APLICACAO POUPANCA\s+([\d.]+,\d{2})", texto, re.I)),
        "Resgates": 0.0,
        "Rendimento bruto mês": sum(texto_para_numero(m.group(1)) for m in re.finditer(r"CAPITALIZ\.\s+REND\.[^\d]*?([\d.]+,\d{2})", texto, re.I)),
        "IRRF": texto_para_numero(irrf.group(1)) if irrf else 0.0,
        "IOF": 0.0,
        "Saldo Bruto": texto_para_numero(atual.group(1)) if atual else 0.0,
        "Banco": nome_banco,
    }


def processar_extrato_sicredi_prazo(caminho_pdf: Path, nome_banco: str) -> dict:
    texto_original = extrair_texto_pdf(caminho_pdf)
    texto = re.sub(r"\s+", " ", texto_original).strip()

    provisionado_anterior = re.search(
        r"([\d.]+,\d{2})\s+\d{2}/\d{2}/\d{4}\s+Rendimentos Provisionados:",
        texto,
        re.I,
    )

    saldo_anterior = re.search(
        r"([\d.]+,\d{2})\s+\d{2}/\d{2}/\d{4}\s+Saldo Anterior:",
        texto,
        re.I,
    )

    valor_provisionado_anterior = (
        texto_para_numero(provisionado_anterior.group(1))
        if provisionado_anterior
        else 0.0
    )

    valor_saldo_anterior = (
        texto_para_numero(saldo_anterior.group(1))
        if saldo_anterior
        else 0.0
    )

    saldo_anterior_total = valor_saldo_anterior + valor_provisionado_anterior

    tabela = re.search(
        r"(\d{2}/\d{4})\s+"
        r"([\d.]+,\d{2})\s+"
        r"([\d.]+,\d{2})\s+"
        r"([\d.]+,\d{2})\s+"
        r"([\d.]+,\d{2})\s+"
        r"([\d.]+,\d{2})\s+"
        r"([\d.]+,\d{2})\s+"
        r"([\d.]+,\d{2})\s+"
        r"([\d.]+,\d{2})",
        texto,
    )

    pos = re.search(
        r"Saldo Atual\s+([\d.]+,\d{2})\s*Rendimentos Provisionados",
        texto,
        re.I,
    )

    return {
        "Arquivo": caminho_pdf.stem,
        "Cliente": extrair_cliente_sicredi(texto_original),
        "Conta": extrair_conta_sicredi_prazo(texto_original),
        "Mês": extrair_mes_sicredi(texto_original),
        "Saldo Anterior": saldo_anterior_total,
        "Aplicações": texto_para_numero(tabela.group(2)) if tabela else 0.0,
        "Resgates": texto_para_numero(tabela.group(3)) if tabela else 0.0,
        "Rendimento bruto mês": texto_para_numero(tabela.group(7)) if tabela else 0.0,
        "IRRF": texto_para_numero(tabela.group(5)) if tabela else 0.0,
        "IOF": texto_para_numero(tabela.group(6)) if tabela else 0.0,
        "Saldo Bruto": (
            texto_para_numero(pos.group(1)) if pos else 0.0
        ) + (
            texto_para_numero(tabela.group(8)) if tabela else 0.0
        ),
        "Banco": nome_banco,
    }


def processar_extrato_xp(caminho_pdf: Path, nome_banco: str) -> dict:
    texto_original = extrair_texto_pdf(caminho_pdf)
    texto = re.sub(r"\s+", " ", texto_original).strip()
    match = re.search(r"[a-z]+\./\d{2}\s+R\$\s*([\d.]+,\d{2})\s+R\$\s*([\d.-]+,\d{2})\s+-R\$\s*([\d.]+,\d{2})\s+R\$\s*([\d.]+,\d{2})\s+R\$\s*([\d.]+,\d{2})\s+R\$\s*([\d.]+,\d{2})", texto, re.I)
    saldo_anterior = aplicacoes = resgates = rendimentos = irrf = iof = saldo_bruto = 0.0
    if match:
        saldo_anterior = texto_para_numero(match.group(1))
        movimentacoes = texto_para_numero(match.group(2))
        irrf = texto_para_numero(match.group(3))
        iof = texto_para_numero(match.group(4))
        saldo_bruto = texto_para_numero(match.group(5))
        rendimentos = texto_para_numero(match.group(6))
        if movimentacoes >= 0:
            aplicacoes = movimentacoes
        else:
            resgates = abs(movimentacoes)
    return {
        "Arquivo": caminho_pdf.stem,
        "Cliente": "",
        "Conta": extrair_conta_xp(texto_original),
        "Mês": extrair_mes_xp(texto_original),
        "Saldo Anterior": saldo_anterior,
        "Aplicações": aplicacoes,
        "Resgates": resgates,
        "Rendimento bruto mês": rendimentos,
        "IRRF": irrf,
        "IOF": iof,
        "Saldo Bruto": saldo_bruto,
        "Banco": nome_banco,
    }


def processar_extrato_itau(caminho_pdf: Path, nome_banco: str) -> dict:
    texto_original = extrair_texto_pdf(caminho_pdf)
    texto = re.sub(r"\s+", " ", texto_original).strip()
    acumulado = re.search(r"Acum\.\s*M[eê]s\s+([\d.]+,\d{2})\s+([\d.]+,\d{2})\s+([\d.]+,\d{2})\s+([\d.]+,\d{2})\s+([\d.]+,\d{2})\s+([\d.]+,\d{2})\s+([\d.]+,\d{2})\s+([\d.]+,\d{2})", texto, re.I)
    anterior = re.search(r"\b31/\d{2}/\d{4}\s+([\d.]+,\d{2})\s+[\d.]+,\d{2}\s+[\d.]+,\d{2}\s+[\d.]+,\d{2}\s+[\d.]+,\d{2}", texto)
    linhas = [l.strip() for l in texto_original.splitlines() if l.strip()]
    saldo_bruto = 0.0
    for i, linha in enumerate(linhas):
        if re.fullmatch(r"\d{2}/\d{2}/\d{4}", linha) and i + 1 < len(linhas):
            if re.fullmatch(r"[\d.]+,\d{2}", linhas[i + 1]):
                saldo_bruto = texto_para_numero(linhas[i + 1])
    return {
        "Arquivo": caminho_pdf.stem,
        "Cliente": extrair_cliente_itau(texto_original),
        "Conta": extrair_conta_itau(texto_original),
        "Mês": extrair_mes_itau(texto_original),
        "Saldo Anterior": texto_para_numero(anterior.group(1)) if anterior else 0.0,
        "Aplicações": texto_para_numero(acumulado.group(1)) if acumulado else 0.0,
        "Resgates": texto_para_numero(acumulado.group(6)) if acumulado else 0.0,
        "Rendimento bruto mês": texto_para_numero(acumulado.group(7)) if acumulado else 0.0,
        "IRRF": texto_para_numero(acumulado.group(5)) if acumulado else 0.0,
        "IOF": texto_para_numero(acumulado.group(4)) if acumulado else 0.0,
        "Saldo Bruto": saldo_bruto,
        "Banco": "Itaú",
    }


def processar_extrato_itau_fundos(
    caminho_pdf: Path,
    nome_banco: str,
) -> dict:
    texto_original = extrair_texto_pdf(caminho_pdf)

    texto = texto_original.replace(
        "\xa0",
        " ",
    )

    conta = ""
    cliente = ""

    match_cabecalho = re.search(
        r"Ag\./Conta\s+"
        r"(\d{1,5})/(\d{1,20}-\d+)",
        texto,
        re.I,
    )

    if match_cabecalho:
        conta = match_cabecalho.group(2)

    match_cliente = re.search(
        r"Folha\s+\d+/\d+\s*"
        r"([^\n]+?)\s*"
        r"FI\d+",
        texto,
        re.I,
    )

    if match_cliente:
        cliente = formatar_nome(
            match_cliente.group(1)
        )

    match_periodo = re.search(
        r"Período:\s*"
        r"\d{2}/\d{2}\s+a\s+"
        r"(\d{2})/(\d{2})/(\d{4})",
        texto,
        re.I,
    )

    mes = ""

    if match_periodo:
        mes = (
            f"{match_periodo.group(2)}/"
            f"{match_periodo.group(3)}"
        )

    saldo_anterior = valor_itau_reais(
        texto,
        r"SALDO\s+BRUTO\s+ANTERIOR",
    )
    
    aplicacoes = valor_itau_reais(
        texto,
        r"APLICACOES",
    )
    
    resgate_bruto = valor_itau_reais(
        texto,
        r"RESGATES",
    )
    
    rendimento_mes = valor_itau_reais(
        texto,
        r"RENDIMENTO\s+BRUTO\s+NO\s+MES",
    )
    
    saldo_bruto = valor_itau_reais(
        texto,
        r"SALDO\s+BRUTO\s+ATUAL",
    )
    
    iof = valor_itau_reais(
        texto,
        r"TOTAL\s+SUJEITO\s+A\s+IOF",
    )
    
    irrf = valor_itau_reais(
        texto,
        r"IR\s+RETIDO\s+NO\s+PERIODO",
    )
    
    resgates_liquidos = max(
        resgate_bruto - irrf,
        0.0,
    )

    return {
        "Arquivo": caminho_pdf.stem,
        "Cliente": cliente,
        "Conta": conta,
        "Mês": mes,
        "Saldo Anterior": saldo_anterior,
        "Aplicações": aplicacoes,
        "Resgates": resgates_liquidos,
        "Rendimento bruto mês": rendimento_mes,
        "IRRF": irrf,
        "IOF": iof,
        "Saldo Bruto": saldo_bruto,
        "Banco": "Itaú",
    }

def processar_extrato_safra(
    caminho_pdf: Path,
    nome_banco: str,
) -> dict:
    texto_original = extrair_texto_pdf(caminho_pdf)

    texto = texto_original.replace(
        "\xa0",
        " ",
    )

    conta = ""

    match_conta = re.search(
        r"Ag[êe]ncia:\s*\d+\s*/\s*"
        r"Conta:\s*([^\n]+)",
        texto,
        re.I,
    )

    if match_conta:
        conta = match_conta.group(1).strip()

    mes = ""

    match_data = re.search(
        r"Data\s+da\s+posi[cç][ãa]o:\s*"
        r"\d{2}/(\d{2})/(\d{4})",
        texto,
        re.I,
    )

    if match_data:
        mes = (
            f"{match_data.group(1)}/"
            f"{match_data.group(2)}"
        )

    marcador_inicio = re.search(
        r"Investimentos\s+Resumo\s+Composi[cç][ãa]o",
        texto,
        re.I,
    )

    if not marcador_inicio:
        return {
            "Arquivo": caminho_pdf.stem,
            "Cliente": "",
            "Banco": "Safra",
            "Conta": conta,
            "Mês": mes,
            "Saldo Anterior": 0.0,
            "Aplicações": 0.0,
            "Resgates": 0.0,
            "Rendimento bruto mês": 0.0,
            "IRRF": 0.0,
            "IOF": 0.0,
            "Saldo Bruto": 0.0,
        }

    texto_composicao = texto[
        marcador_inicio.end():
    ]

    marcador_renda_fixa = re.search(
        r"\bRENDA\s+FIXA\b",
        texto_composicao,
        re.I,
    )

    if not marcador_renda_fixa:
        return {
            "Arquivo": caminho_pdf.stem,
            "Cliente": "",
            "Banco": "Safra",
            "Conta": conta,
            "Mês": mes,
            "Saldo Anterior": 0.0,
            "Aplicações": 0.0,
            "Resgates": 0.0,
            "Rendimento bruto mês": 0.0,
            "IRRF": 0.0,
            "IOF": 0.0,
            "Saldo Bruto": 0.0,
        }

    texto_valores = texto_composicao[
        marcador_renda_fixa.end():
    ]

    tokens = re.findall(
        r"-|[0-9.]+,\d{2}",
        texto_valores,
    )

    valores = []

    for token in tokens:
        if token == "-":
            valores.append(0.0)
        else:
            valores.append(
                texto_para_numero(token)
            )

        if len(valores) == 8:
            break

    while len(valores) < 8:
        valores.append(0.0)

    (
        saldo_anterior,
        aplicacoes,
        resgates,
        impostos_incorridos,
        rendimento,
        saldo_bruto,
        impostos_previstos,
        saldo_liquido,
    ) = valores[:8]

    return {
        "Arquivo": caminho_pdf.stem,
        "Cliente": "",
        "Banco": "Safra",
        "Conta": conta,
        "Mês": mes,
        "Saldo Anterior": saldo_anterior,
        "Aplicações": aplicacoes,
        "Resgates": resgates,
        "Rendimento bruto mês": rendimento,
        "IRRF": impostos_incorridos,
        "IOF": 0.0,
        "Saldo Bruto": saldo_bruto,
    }






