def encontrar_pastas_aplicacao(pasta_raiz: Path):
    pastas = []
    for pasta_banco in pasta_raiz.iterdir():
        if not pasta_banco.is_dir():
            continue
        for sub in pasta_banco.iterdir():
            if sub.is_dir() and sub.name.upper() in ("APLICAÇÃO", "APLICACAO"):
                pastas.append((sub, pasta_banco.name))
    return pastas


def registro_erro(arquivo: Path, nome_banco: str, status: str, motivo: str) -> dict:
    registro = {coluna: "" for coluna in COLUNAS}
    registro["Arquivo"] = arquivo.stem
    registro["Banco"] = nome_banco
    registro["Status"] = status
    registro["Motivo"] = motivo
    return registro


def registro_processado(registro: dict) -> dict:
    registro["Status"] = "Processado"
    registro["Motivo"] = ""
    return registro


def processar_arquivo(arquivo: Path, nome_banco: str) -> dict:
    banco = nome_banco.lower()

    if "001" in banco or "caixa" in banco:
        return registro_processado(processar_extrato_caixa(arquivo, nome_banco))
    if "bb" in banco or "banco do brasil" in banco:
        texto = re.sub(r"\s+", " ", extrair_texto_pdf(arquivo)).strip()
        if "Extratos - Investimentos Fundos - Mensal" in texto:
            return registro_processado(processar_extrato_bb(arquivo, nome_banco))
        return registro_processado(processar_extrato_bb_resumo(arquivo, nome_banco))
    if "bradesco" in banco or "brad" in banco:
        return registro_processado(processar_extrato_bradesco(arquivo, nome_banco))
    if "sicredi" in banco:
        texto = re.sub(r"\s+", " ", extrair_texto_pdf(arquivo)).strip()
        if "Depósito a Prazo" in texto:
            return registro_processado(processar_extrato_sicredi_prazo(arquivo, nome_banco))
        return registro_processado(processar_extrato_sicredi_poupanca(arquivo, nome_banco))
    if "safra" in banco:
        texto = re.sub(
            r"\s+",
            " ",
            extrair_texto_pdf(arquivo),
        ).strip()
    
        if re.search(
            r"Investimentos\s+Resumo\s+Composição",
            texto,
            re.I,
        ):
            return registro_processado(
                processar_extrato_safra(
                    arquivo,
                    nome_banco,
                )
            )
    
        return registro_erro(
            arquivo,
            nome_banco,
            "Modelo Safra não identificado",
            "O PDF não contém o título Investimentos Resumo Composição.",
        )
    if "itau" in banco or "itaú" in banco:
        texto_original = extrair_texto_pdf(arquivo)

        texto = re.sub(
            r"\s+",
            " ",
            texto_original,
        ).strip()

        if eh_itau_fundos_investimento(texto):
            return registro_processado(
                processar_extrato_itau_fundos(
                    arquivo,
                    nome_banco,
                )
            )
    
        return registro_processado(
            processar_extrato_itau(
                arquivo,
                nome_banco,
            )
        )
    if "xp" in banco:
        return registro_processado(processar_extrato_xp(arquivo, nome_banco))

    return registro_erro(
        arquivo,
        nome_banco,
        "Banco não programado",
        f"Não há processador cadastrado para o banco da pasta: {nome_banco}",
    )


def processar_todos_extratos(pasta_raiz: Path, callback=None):
    pastas = encontrar_pastas_aplicacao(pasta_raiz)
    if not pastas:
        raise FileNotFoundError("Nenhuma pasta 'Aplicação' ou 'Aplicacao' encontrada.")

    arquivos = [(pdf, banco) for pasta, banco in pastas for pdf in sorted(pasta.glob("*.pdf"))]
    if not arquivos:
        raise FileNotFoundError("Nenhum arquivo PDF encontrado nas pastas de aplicação.")

    resultados = []
    erros = []
    total = len(arquivos)

    for indice, (arquivo, nome_banco) in enumerate(arquivos, start=1):
        if callback:
            callback(indice - 1, total, arquivo.name)

        try:
            resultado = processar_arquivo(arquivo, nome_banco)
            resultados.append(resultado)
            if resultado["Status"] != "Processado":
                erros.append(f"{arquivo.name}: {resultado['Motivo']}")
        except Exception as erro:
            motivo = str(erro) or "Falha não identificada durante a leitura do PDF."
            resultados.append(registro_erro(arquivo, nome_banco, "Erro de leitura", motivo))
            erros.append(f"{arquivo.name}: {motivo}")

        if callback:
            callback(indice, total, arquivo.name)

    return resultados, erros


def formatar_aba(ws, colunas: list[str], aplicar_moeda: bool = False):
    preenchimento = PatternFill(fill_type="solid", fgColor=COR_CABECALHO)
    fonte = Font(color="FFFFFF", bold=True)

    for celula in ws[1]:
        celula.fill = preenchimento
        celula.font = fonte

    if aplicar_moeda:
        for linha in range(2, ws.max_row + 1):
            for coluna, nome in enumerate(colunas, start=1):
                if nome in COLUNAS_MONETARIAS:
                    ws.cell(row=linha, column=coluna).number_format = "#,##0.00"

    for coluna in ws.columns:
        tamanho = max(len("" if celula.value is None else str(celula.value)) for celula in coluna)
        ws.column_dimensions[coluna[0].column_letter].width = min(max(tamanho + 2, 12), 60)
    
    ws.column_dimensions["M"].width = 14
    ws.freeze_panes = "A2"
    ws.auto_filter.ref = ws.dimensions


def salvar_planilha(extratos: list[dict], pasta_saida: Path) -> Path:
    if not extratos:
        raise ValueError("Não há extratos para exportar.")

    wb = Workbook()
    ws_extratos = wb.active
    ws_extratos.title = "Extratos"
    ws_extratos.append(COLUNAS)

    def chave_mes(registro):
        mes = str(registro.get("Mês", "")).strip()

        try:
            numero_mes, ano = mes.split("/")
            return int(ano), int(numero_mes)
        except (ValueError, AttributeError):
            return 9999, 99

    extratos_processados = [
        registro
        for registro in extratos
        if registro.get("Status") == "Processado"
    ]

    extratos_processados.sort(key=chave_mes)

    for registro in extratos_processados:
        proxima_linha = ws_extratos.max_row + 1

        linha = []
        for coluna in COLUNAS:
            if coluna == "Check":
                linha.append(
                    f"=F{proxima_linha}+G{proxima_linha}-H{proxima_linha}"
                    f"+I{proxima_linha}-J{proxima_linha}-K{proxima_linha}-L{proxima_linha}"
                )
            else:
                linha.append(registro.get(coluna, ""))

        ws_extratos.append(linha)

    formatar_aba(ws_extratos, COLUNAS, aplicar_moeda=True)

    ws_erros = wb.create_sheet("Erros de leitura")
    ws_erros.append(COLUNAS_ERROS)

    for registro in extratos:
        if registro.get("Status") != "Processado":
            ws_erros.append([
                registro.get(coluna, "")
                for coluna in COLUNAS_ERROS
            ])

    formatar_aba(ws_erros, COLUNAS_ERROS)

    caminho_saida = pasta_saida / "extratos_aplicacao.xlsx"
    wb.save(caminho_saida)
    return caminho_saida


