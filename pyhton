def extrair_campo(texto: str, rotulo: str):
    m = re.search(rotulo + r"\s*([0-9.]+,\d{2}[CD]?)", texto, re.I)
    return m.group(1).rstrip("CD").rstrip("cd") if m else "0,00"


def extrair_mes_ano(texto: str, rotulo: str):
    m = re.search(rotulo + r"\s*(\d{2}/\d{4})", texto, re.I)
    return m.group(1) if m else ""


def extrair_mes_ano_referencia_bb(texto: str):
    m = re.search(r"M[êe]s/ano\s+refer[êe]ncia\s+([A-ZÇÃÕ]+)/([0-9]{4})", texto, re.I)
    if not m:
        return ""
    mapa = {
        "JANEIRO": "01", "FEVEREIRO": "02", "MARÇO": "03", "MARCO": "03",
        "ABRIL": "04", "MAIO": "05", "JUNHO": "06", "JULHO": "07",
        "AGOSTO": "08", "SETEMBRO": "09", "OUTUBRO": "10",
        "NOVEMBRO": "11", "DEZEMBRO": "12",
    }
    mes_nome = re.sub(r"[\u0300-\u036f]", "", m.group(1).upper())
    mes_num = mapa.get(mes_nome)
    return f"{mes_num}/{m.group(2)}" if mes_num else ""


def extrair_mes_ano_resumo_bb(texto: str):
    m = re.search(r"Resumo do mês\s*-\s*([A-Za-zçãõáéíóú]+)/([0-9]{4})", texto)
    if not m:
        return ""
    mapa = {
        "janeiro": "01", "fevereiro": "02", "março": "03", "marco": "03",
        "abril": "04", "maio": "05", "junho": "06", "julho": "07",
        "agosto": "08", "setembro": "09", "outubro": "10",
        "novembro": "11", "dezembro": "12",
    }
    mes_nome = re.sub(r"[\u0300-\u036f]", "", m.group(1).lower())
    mes_num = mapa.get(mes_nome)
    return f"{mes_num}/{m.group(2)}" if mes_num else ""


def formatar_nome(nome: str) -> str:
    nome = re.sub(r"\n+", " ", nome)
    nome = re.sub(r"\s+", " ", nome).strip().lower()
    nome = re.sub(r"\b\w", lambda m: m.group(0).upper(), nome)
    for p, r in [
        (r"\bSpe\b", "SPE"),
        (r"\bLtda\b", "LTDA"),
        (r"\bS/a\b", "S/A"),
        (r"\bEireli\b", "EIRELI"),
        (r"\bMe\b", "ME"),
        (r"\bEpp\b", "EPP"),
    ]:
        nome = re.sub(p, r, nome, flags=re.I)
    return nome


def extrair_nome_cliente_generico(texto_original: str):
    match = re.search(
        r"Cliente[\s\S]*?Nome\s*\n\s*([\s\S]*?)"
        r"(?=\n\s*(?:CPF\/CNPJ|Conta Corrente|M[eê]s/Ano|Folha|An[aá]lise do Perfil do Investidor|Data da Avalia[cç][aã]o)\b)",
        texto_original,
        re.I,
    )
    return formatar_nome(match.group(1)) if match else ""


def extrair_nome_cliente_bb(texto_original: str):
    linha = re.search(r"Conta\s+\d{1,20}-\d+\s+(.+)\n", texto_original, re.I)
    if linha:
        bruto = re.sub(r"\s+", " ", linha.group(1)).strip()
        if bruto.lower() != "cliente" and len(bruto) > 3:
            return formatar_nome(bruto)

    linhas = texto_original.splitlines()
    for i in range(len(linhas) - 1, -1, -1):
        if linhas[i].strip().lower() == "cliente" and i + 1 < len(linhas):
            candidato = linhas[i + 1].strip()
            if len(candidato) >= 3 and any(c.isalpha() for c in candidato):
                return formatar_nome(candidato)
    return ""


def extrair_texto_pdf(caminho_pdf: Path) -> str:
    doc = fitz.open(caminho_pdf)
    try:
        return "".join(pagina.get_text() for pagina in doc)
    finally:
        doc.close()


def extrair_valor_proxima_linha(texto: str, rotulo: str):
    m = re.search(rf"{rotulo}\s*\n\s*([0-9.]+,\d{{2}})", texto, re.I)
    return m.group(1) if m else "0,00"


def extrair_valor(texto: str, padrao: str):
    m = re.search(padrao + r"\s*:?\s*R?\s*\$?\s*([0-9.]+,\d{2})", texto, re.I)
    return m.group(1) if m else "0,00"


def texto_para_numero(valor):
    if not valor or valor == "0,00":
        return 0.0
    valor = str(valor).replace("R$", "").replace(" ", "")
    negativo = valor.startswith("-")
    valor = valor.lstrip("-")
    numero = float(valor.replace(".", "").replace(",", "."))
    return -numero if negativo else numero


